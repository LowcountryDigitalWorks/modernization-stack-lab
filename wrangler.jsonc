{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ldw-modernization-stack-lab",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
